# =============================================================
# Cadencia / Maestro Mentor Guide — Variables de Entorno de Ejemplo
# =============================================================
# Copia este archivo a .env.local y completa tus credenciales reales.
# =============================================================

# BACKEND (Insforge PostgREST o Supabase)
VITE_INSFORGE_URL=https://your-project.us-east.insforge.app/rest/v1
VITE_INSFORGE_ANON_KEY=your_anon_key_here

# URL base de la API
VITE_API_BASE_URL=http://localhost:5173

# CULQI (Pasarela de Pago Peruana)
VITE_CULQI_PUBLIC_KEY=pk_test_TuClavePublicaCulqi

# ENTORNO
VITE_APP_ENV=development
VITE_APP_NAME=Cadencia
VITE_APP_ACADEMY_NAME=Vibra Music
