SELECT conname, pg_get_constraintdef(oid) AS check_def
FROM pg_constraint WHERE conname = 'progress_reports_period_type_check';
-- Resultado previo: CHECK ((period_type = ANY (ARRAY['mensual'::text, 'trimestral'::text])))

SELECT indexname, indexdef
FROM pg_indexes WHERE tablename = 'progress_reports' AND indexname = 'progress_reports_unique_period';
-- Resultado previo: (0 filas - no existía)
