# Grafo de Dependencias de Componentes y Servicios (Graphify - Actualizado 2026-10-09)

```mermaid
graph LR
    %% UI Components
    subgraph UI_Layer ["Capa de Interfaz de Usuario"]
        AgendaBoardComp["agenda-board.tsx (⚡ 90m badge)"]
        StudentsTableComp["students-table.tsx (Anti-Autofill)"]
        StudentAttendanceKardexComp["student-attendance-kardex.tsx (Kardex 90m)"]
        StudentCleanupPanelComp["student-cleanup-panel.tsx (Depuración)"]
        DeletionPanelComp["deletion-requests-panel.tsx"]
        AlertsPanelComp["alerts-panel.tsx"]
        RiskFamiliesComp["risk-families-table.tsx"]
        ControlHorarioComp["admin.control-horario.tsx"]
        InvitacionesComp["admin.invitaciones.tsx"]
        FacturacionComp["admin.facturacion.tsx"]
        TeacherAlumnosComp["teacher.alumnos.tsx"]
        TeacherIndexComp["teacher.index.tsx (Kiosco Docente)"]
        RenewalsPanelComp["student-renewals-retention-panel.tsx"]
    end

    %% State & Logic
    subgraph State_Layer ["Capa de Estado y Lógica de Negocio"]
        Store["app-store.ts (Zustand + Persist)"]
        Seeds["admin-seeds.ts & official-seeds.ts"]
        RoomComp["room-compatibility.ts (ADR-0121 & ADR-0122)"]
        StudentCycle["student-cycle.ts (ADR-0108, ADR-0165 & ADR-0166)"]
        KardexCalc["kardex-calculator.ts (ADR-0162, ADR-0164 & ADR-0166)"]
    end

    %% Audio & Media
    subgraph Media_Layer ["Audio & Timbre Oficial"]
        SchoolBellMp3["/school bell.mp3"]
        AudioCtx["Web Audio API Fallback"]
    end

    %% External APIs
    subgraph External_APIs ["APIs Externas"]
        WhatsApp["WhatsApp Business API (wa.me)"]
    end

    %% Backend Services
    subgraph Backend_Layer ["Capa de Backend (Insforge PostgREST)"]
        InsforgeClient["insforge.ts Client"]
        StudentsSvc["students.service.ts"]
        AttendanceSvc["attendance.service.ts"]
        InvitationsSvc["invitations.service.ts"]
        InvoicesSvc["invoices.service.ts"]
        AuthSvc["auth.service.ts"]
        PgTables[("PostgreSQL Database (Insforge MCP)")]
    end

    %% Relaciones
    AgendaBoardComp --> Store
    AgendaBoardComp --> RoomComp
    AgendaBoardComp --> StudentCycle
    StudentsTableComp --> Store
    StudentsTableComp --> RoomComp
    StudentsTableComp --> StudentCycle
    StudentsTableComp --> StudentCleanupPanelComp
    StudentsTableComp --> StudentAttendanceKardexComp
    StudentAttendanceKardexComp --> Store
    StudentAttendanceKardexComp --> StudentCycle
    StudentAttendanceKardexComp --> KardexCalc
    TeacherIndexComp --> Store
    TeacherIndexComp --> StudentCycle
    TeacherIndexComp --> KardexCalc
    TeacherAlumnosComp --> Store
    TeacherAlumnosComp --> StudentAttendanceKardexComp
    RenewalsPanelComp --> Store
    RenewalsPanelComp --> StudentCycle
    DeletionPanelComp --> Store
    AlertsPanelComp --> Store
    RiskFamiliesComp --> Store
    ControlHorarioComp --> Store
    InvitacionesComp --> InvitationsSvc
    FacturacionComp --> InvoicesSvc
    StudentsTableComp --> WhatsApp
    StudentAttendanceKardexComp --> WhatsApp
    RiskFamiliesComp --> WhatsApp
    FacturacionComp --> WhatsApp

    Store --> Seeds
    Store --> SchoolBellMp3
    Store --> AudioCtx
    StudentsSvc --> InsforgeClient
    AttendanceSvc --> InsforgeClient
    InvitationsSvc --> InsforgeClient
    InvoicesSvc --> InsforgeClient
    AuthSvc --> InsforgeClient
    InsforgeClient --> PgTables
```
